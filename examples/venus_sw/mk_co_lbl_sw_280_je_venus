#!/bin/bash


if [ $RAD_BIN ] ; then
  echo "Using code compiled in "$RAD_BIN
else
  echo "Path to code not set."
  exit 1
fi

# Set environment variables
procs=${VENUS_SW_PROCS:-12}
. ./env_sw_280_venus

HITRAN_CO="$LINE_DATA_DIR/HITRAN2020_CO.par_co2"
if [ ! -s $HITRAN_CO ] ; then
  echo "$HITRAN_CO does not exist or is empty"
fi

mkdir -p ${SW_DATA}
mkdir -p ${SP_DIR}
./mk_sp_sw_280_je_venus_skel ${SKELFILE}

echo "Generating CO line absorption data"
if [ ! -s $SW_DATA/co_lbl_280_${PT_FILE}.nc ] ; then
  rm -f $SW_DATA/co_lbl_280_l*
  Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} -BD $HITRAN_CO \
    -R 104 280 -c 5000.0 -i 0.2 \
    -l 5 ${COL_MASS_K_CO} -n 1 \
    -s ${SKELFILE} +S $SOLSPEC -lk \
    -o $SW_DATA/co_lbl_280_l -m $SW_DATA/co_lbl_280_lm \
    -L $SW_DATA/co_lbl_280_${PT_FILE}.nc \
    -np $procs \
    > $SW_DATA/co_lbl_log
else
  echo "CO absorption file already exists"
fi

exit 0
