#!/bin/bash


if [ $RAD_BIN ] ; then
  echo "Using code compiled in "$RAD_BIN
else
  echo "Path to code not set."
  exit 1
fi

# Set environment variables
procs=${VENUS_SW_PROCS:-12}
. ./env_sw_280_venus

HITRAN_HF="$LINE_DATA_DIR/HITRAN2020_HF.par_co2"
if [ ! -s $HITRAN_HF ] ; then
  echo "$HITRAN_HF does not exist or is empty"
fi

mkdir -p ${SW_DATA}
mkdir -p ${SP_DIR}
./mk_sp_sw_280_je_venus_skel ${SKELFILE}

echo "Generating HF line absorption data"
if [ ! -s $SW_DATA/hf_lbl_280_${PT_FILE}.nc ] ; then
  rm -f $SW_DATA/hf_lbl_280_l*
  Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} -BD $HITRAN_HF \
    -R 104 280 -c 5000.0 -i 0.2 \
    -l 52 ${COL_MASS_K_HF} -n 1 \
    -s ${SKELFILE} +S $SOLSPEC -lk \
    -o $SW_DATA/hf_lbl_280_l -m $SW_DATA/hf_lbl_280_lm \
    -L $SW_DATA/hf_lbl_280_${PT_FILE}.nc \
    -np $procs \
    > $SW_DATA/hf_lbl_log
else
  echo "HF absorption file already exists"
fi 

exit 0
