#!/usr/bin/env python3
"""Compares two spectral files block by block, number by number.

Usage: ./compare_sp <reference spectral file> <new spectral file>

For each block of the main file it prints how many numbers the block holds,
the largest absolute difference and the largest relative difference,
|a - b| / max(|a|, |b|). A block whose number count differs between the files
is reported as such and not compared further.

For block 5 (gas k-terms) it also compares the number of k-terms of every
(band, gas) pair and lists the pairs where they differ.

The k-coefficient look-up tables (the files with the suffix _k) are compared
the same way, as one stream of numbers, when both exist.

Needs only the Python standard library.
"""
import itertools
import os
import re
import sys

NUMBER = re.compile(r'^[-+]?(\d+\.?\d*|\.\d+)([eEdD][-+]?\d+)?$')
BLOCK = re.compile(r'^\*BLOCK:\s*TYPE\s*=\s*(\d+)', re.IGNORECASE)
MAX_LISTED = 40


def numbers(line):
    """The numeric tokens of a line, as floats."""
    out = []
    for tok in re.sub(r'[,;=(){}:]', ' ', line).split():
        if NUMBER.match(tok):
            out.append(float(tok.replace('D', 'E').replace('d', 'e')))
    return out


def read_blocks(path):
    """Ordered list of (label, lines) for the blocks of a spectral file."""
    blocks, seen, lines, label = [], {}, None, None
    with open(path) as f:
        for line in f:
            m = BLOCK.match(line)
            if m:
                btype = int(m.group(1))
                seen[btype] = seen.get(btype, 0) + 1
                label, lines = (btype, seen[btype]), []
            elif line.startswith('*END'):
                if lines is not None:
                    blocks.append((label, lines))
                lines = None
            elif lines is not None:
                lines.append(line)
    return blocks


class Stats:
    """Running largest absolute and relative differences."""

    def __init__(self):
        self.n = 0
        self.abs = 0.0
        self.rel = 0.0
        self.rel_pair = (0.0, 0.0)

    def add(self, a, b):
        self.n += 1
        d = abs(a - b)
        if d > self.abs:
            self.abs = d
        scale = max(abs(a), abs(b))
        if scale > 0.0 and d / scale > self.rel:
            self.rel = d / scale
            self.rel_pair = (a, b)

    def __str__(self):
        s = 'values %8d  max|diff| %.3e  max rel %.3e' % (self.n, self.abs, self.rel)
        if self.rel > 0.0:
            s += '  (ref %.9e, new %.9e)' % self.rel_pair
        return s


def compare_lines(ref_lines, new_lines):
    a = [x for line in ref_lines for x in numbers(line)]
    b = [x for line in new_lines for x in numbers(line)]
    if len(a) != len(b):
        return 'number count differs: %d vs %d' % (len(a), len(b))
    st = Stats()
    for x, y in zip(a, b):
        st.add(x, y)
    return str(st)


def k_entries(lines):
    """Block 5 as {(band, gas index): [numbers of the entry]}, in file order.

    An entry starts at a line of five integers: band, gas, number of k-terms,
    scaling type, scaling function. The first number kept is the k-term count.
    """
    header = re.compile(r'^\s*(\d+)\s+(\d+)\s+(\d+)\s+\d+\s+\d+\s*$')
    entries, key, started = {}, None, False
    for line in lines:
        if not started:
            started = 'k-terms, weights and scaling' in line
            continue
        m = header.match(line)
        if m:
            key = (int(m.group(1)), int(m.group(2)))
            entries[key] = [float(m.group(3))]
        elif key is not None:
            entries[key].extend(numbers(line))
    return entries


def compare_k_terms(ref_lines, new_lines):
    ref, new = k_entries(ref_lines), k_entries(new_lines)
    only_ref = sorted(set(ref) - set(new))
    only_new = sorted(set(new) - set(ref))
    common = [k for k in ref if k in new]
    differ = [k for k in common if ref[k][0] != new[k][0]]
    print('    (band, gas) pairs: %d in ref, %d in new, %d in both'
          % (len(ref), len(new), len(common)))
    print('    total k-terms: %d in ref, %d in new'
          % (sum(v[0] for v in ref.values()), sum(v[0] for v in new.values())))
    for name, keys in (('only in ref', only_ref), ('only in new', only_new)):
        if keys:
            shown = ', '.join('(%d, %d)' % k for k in keys[:MAX_LISTED])
            more = ' ...' if len(keys) > MAX_LISTED else ''
            print('    %s: %s%s' % (name, shown, more))
    print('    pairs whose k-term count differs: %d' % len(differ))
    for k in differ[:MAX_LISTED]:
        print('      band %3d gas %2d: %d in ref, %d in new'
              % (k[0], k[1], ref[k][0], new[k][0]))
    if len(differ) > MAX_LISTED:
        print('      ...')
    st = Stats()
    for k in common:
        if ref[k][0] == new[k][0] and len(ref[k]) == len(new[k]):
            for x, y in zip(ref[k], new[k]):
                st.add(x, y)
    print('    pairs with equal k-term count: %s' % st)


def stream(path):
    with open(path) as f:
        for line in f:
            for x in numbers(line):
                yield x


def compare_tables(ref_path, new_path):
    st = Stats()
    for x, y in itertools.zip_longest(stream(ref_path), stream(new_path)):
        if x is None or y is None:
            return 'number count differs (first %d numbers: %s)' % (st.n, st)
        st.add(x, y)
    return str(st)


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    ref_path, new_path = sys.argv[1], sys.argv[2]
    ref, new = read_blocks(ref_path), read_blocks(new_path)
    new_by_label = dict(new)
    ref_labels = [label for label, _ in ref]
    for label, lines in ref:
        name = 'block %2d' % label[0] + (' #%d' % label[1] if label[1] > 1 else '   ')
        if label not in new_by_label:
            print('%s  missing from new file' % name)
            continue
        print('%s  %s' % (name, compare_lines(lines, new_by_label[label])))
        if label[0] == 5:
            compare_k_terms(lines, new_by_label[label])
    for label, _ in new:
        if label not in ref_labels:
            print('block %2d #%d  only in new file' % label)
    if os.path.exists(ref_path + '_k') and os.path.exists(new_path + '_k'):
        print('k-table   %s' % compare_tables(ref_path + '_k', new_path + '_k'))
    else:
        print('k-table   not compared: a _k file is missing')


if __name__ == '__main__':
    main()
