#!/bin/bash
# Runs the column of run_column_venus at a set of solar zenith angles, so
# that global and zonal day means can be formed afterwards by integrating
# over mu = cos(zenith angle):
#   mu = 0.05, 0.10, ..., 1.00, evenly spaced for integration in mu;
#   45 and 65.6 degrees, the angles to which the Venera and Pioneer Venus
#   flux measurements are referred.
#
# Usage, inside the container:
#   ./podman_socrates ./run_column_sweep <tag> [spectral file]
# Output: VENUS_SW_WORK/column/<tag>/sz<angle>/, one run_column_venus
# directory per angle, the angle written with two decimals.

set -eu
cd "$(dirname "$0")"
tag=$1
# An empty spectral file argument makes run_column_venus use its default.
sp=${2:-}

angles=$(python3 -c '
import math
mus = [0.05 * i for i in range(1, 21)]
angles = [math.degrees(math.acos(min(m, 1.0))) for m in mus] + [45.0, 65.6]
print(" ".join("%.2f" % a for a in sorted(set(round(a, 2) for a in angles))))
')

for a in $angles ; do
  echo -n "zenith $a: "
  ./run_column_venus "$tag/sz$a" "$sp" "$a"
done
