#!/bin/bash

if [ $RAD_BIN ] ; then
  echo "Using code compiled in "$RAD_BIN
else
  echo "Path to code not set."
  exit 1
fi

# Set environment variables
procs=${VENUS_SW_PROCS:-24}
. ./env_sw_280_venus

HITRAN_H2O="$LINE_DATA_DIR/HITRAN2020_H2O.par"
CONT_H2O_FRN="${RAD_DATA}/continua/caviar_frn"

if [ ! -s $HITRAN_H2O ] ; then
    echo "$HITRAN_H2O not found or is empty"
fi

mkdir -p ${SW_DATA}
mkdir -p ${SP_DIR}
./mk_sp_sw_280_je_venus_skel ${SKELFILE} > /dev/null

if [ ! -s $SW_DATA/hdo_lbl_vis_${PT_FILE}.nc ] ; then
  echo "Generating HDO line absorption data: visible"
  rm -f $SW_DATA/hdo_lbl_vis_l*
  Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} -D $HITRAN_H2O \
    -R 30 65 -c 2500.0 -i 1.0 \
    -l 50 ${COL_MASS_K_HDO} -n 1 \
    -s ${SKELFILE} +S $SOLSPEC -lk \
    -o $SW_DATA/hdo_lbl_vis_l -m $SW_DATA/hdo_lbl_vis_lm \
    -L $SW_DATA/hdo_lbl_vis_${PT_FILE}.nc \
    -np $procs \
    > $SW_DATA/hdo_lbl_vis_log
else
  echo "HDO visible absorption file already exists"
fi

if [ ! -s $SW_DATA/hdo_lbl_swf_${PT_FILE}.nc ] ; then
  echo "Generating HDO line absorption data: near-IR"
  rm -f $SW_DATA/hdo_lbl_swf_l*
  Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} -D $HITRAN_H2O \
    -R 66 280 -c 2500.0 -i 1.0 \
    -l 50 ${COL_MASS_K_HDO} -n 1 \
    -s ${SKELFILE} +S $SOLSPEC -lk \
    -o $SW_DATA/hdo_lbl_swf_l -m $SW_DATA/hdo_lbl_swf_lm \
    -L $SW_DATA/hdo_lbl_swf_${PT_FILE}.nc \
    -np $procs \
    > $SW_DATA/hdo_lbl_swf_log
else
  echo "HDO near-IR absorption file already exists"
fi

exit 0
