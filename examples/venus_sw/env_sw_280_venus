# Line-by-line absorption files (large, slow to make) and the spectral file
# with its intermediate k files go under VENUS_SW_WORK, outside the source tree.
# LINE_DATA_DIR holds the HITRAN line lists, which are not kept in git.
VENUS_SW_WORK="${VENUS_SW_WORK:?Set VENUS_SW_WORK to the work directory}"
LINE_DATA_DIR="${LINE_DATA_DIR:?Set LINE_DATA_DIR to the HITRAN line-list directory}"
SW_DATA="${VENUS_SW_WORK}/lbl"
SP_DIR="${VENUS_SW_WORK}/sp"

SKELFILE="$SP_DIR/sp_sw_280_je_venus_skel"
# Skeleton of our own file: SO added, OSSO isomers left out.
SKELFILE_VENUS="$SP_DIR/sp_sw_280_venus_skel"

# UV absorber, VENUS_UV_ABSORBER:
#   crisp  Crisp (1986): absorption only, in the soluble slot (default);
#   ph     Perez-Hoyos et al. (2018): mode 1 above 65 km made of absorbing
#          particles, in the soluble slot; mode 1 below 65 km stays plain
#          acid in the soot slot (profiles from mk_haus_cloud);
#   haus   Haus et al. (2015): absorption only, in the soluble slot, with
#          their cross-section and profile (mk_haus_uv_absorber).
# It selects the soluble slot's optics (run_scatter), the soot and soluble
# profiles (mk_venus_atm) and, for ph and haus, a spectral file of its own.
VENUS_UV_ABSORBER="${VENUS_UV_ABSORBER:-crisp}"
case "$VENUS_UV_ABSORBER" in
  crisp) SPECFILE_VENUS="$SP_DIR/sp_sw_280_venus" ;;
  ph)    SPECFILE_VENUS="$SP_DIR/sp_sw_280_venus_ph" ;;
  haus)  SPECFILE_VENUS="$SP_DIR/sp_sw_280_venus_haus" ;;
  *)     echo "VENUS_UV_ABSORBER must be crisp, ph or haus, not $VENUS_UV_ABSORBER" >&2
         exit 1 ;;
esac

