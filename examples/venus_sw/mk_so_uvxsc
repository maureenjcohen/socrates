#!/usr/bin/env python3
"""Writes so.uvxsc, the temperature-dependent UV cross-sections of
sulphur monoxide (32S16O) for Ccorr_k -UVX, from the hybrid photoabsorption
cross-sections of Heays et al. (2023, Mol. Phys. 121, e2153092).

One record per temperature, at the native resolution of the data:
40000-53000 cm-1 (188.7-250 nm) in 0.01 cm-1 steps, 1.3 million points.
The data are Doppler-broadened only, so the records carry zero pressure.
The twelve temperatures (100-500 K in 50 K steps, 600, 700, 800 K) bracket
every temperature of the Venus p-T grid.

The output is about 250 MB of text: it stays out of git.

Input: a directory holding
hybrid_photoabsorption_cross_section_32S16O_<T>K.h5 (dataset "data":
wavenumber in cm-1, cross-section in cm2).

Usage: mk_so_uvxsc <Heays data directory> [output file]
Needs Python 3 with numpy and h5py.
"""
import os
import sys

import h5py
import numpy as np

HERE = os.path.dirname(os.path.abspath(__file__))
TEMPS = [100, 150, 200, 250, 300, 350, 400, 450, 500, 600, 700, 800]
# Values below this are written as zero; the format has two-digit exponents.
SIGMA_MIN = 1.0e-99


def main():
    if len(sys.argv) not in (2, 3):
        sys.exit(__doc__)
    indir = sys.argv[1]
    out = sys.argv[2] if len(sys.argv) == 3 else os.path.join(HERE, 'so.uvxsc')
    grid = None
    with open(out, 'w') as f:
        for t in TEMPS:
            path = os.path.join(
                indir, 'hybrid_photoabsorption_cross_section_32S16O_%dK.h5' % t)
            with h5py.File(path, 'r') as h:
                d = h['data'][...]
            nu, sig = d[:, 0], d[:, 1]
            step = np.diff(nu)
            if not np.allclose(step, step[0], rtol=1e-6, atol=1e-7):
                sys.exit('Uneven wavenumber grid at %d K' % t)
            if grid is None:
                grid = (nu[0], nu[-1], len(nu))
            elif grid != (nu[0], nu[-1], len(nu)):
                sys.exit('Grid at %d K differs from the first' % t)
            if (sig < 0).any():
                sys.exit('Negative cross-section at %d K' % t)
            sig = np.where(sig >= SIGMA_MIN, sig, 0.0)
            f.write('%-20s%16.4f%16.4f%7d%7.2f%6.1f%16.9E %-5s%-15s    %-3s%3d\n'
                    % ('SO', nu[0], nu[-1], len(nu), t, 0.0, sig.max(),
                       '0.010', 'Heays2023', '', 0))
            n_full = len(sig) // 10 * 10
            np.savetxt(f, sig[:n_full].reshape(-1, 10), fmt='%16.9E',
                       delimiter='')
            if n_full < len(sig):
                f.write(''.join('%16.9E' % s for s in sig[n_full:]) + '\n')
            print('%4d K: max %.3e cm2 at %.2f cm-1'
                  % (t, sig.max(), nu[np.argmax(sig)]))
    print('wrote %s: %d records, %.2f-%.2f cm-1, %d points each'
          % (out, len(TEMPS), grid[0], grid[1], grid[2]))


if __name__ == '__main__':
    main()
