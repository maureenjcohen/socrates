#!/bin/bash
echo "starting mk_sp_sw_280_je_venus_skel"
if [ $RAD_BIN ] ; then
  echo "Using code compiled in "$RAD_BIN
else
  echo "Path to code not set."
  exit 1
fi

skelfile=$1
if [ ! -s ${skelfile} ] ; then

# Create skeleton spectral file:
# 280 bands
# 13 gases: H2O (1), CO2 (2), SO2 (9), N2 (13), CO (5), OCS (25), H2S (36), HDO (50), HCl (51), HF (52), cis-OSSO (53), trans-OSSO (54), OSO-S (55)
# 2 CIA: H2O-H2O, CO2-CO2
# 5 aerosol: soluble (1) oceanic (3) soot (4), ash (5), sulphuric acid (6)
# Bands specified in microns (u)
prep_spec << EOF > ${skelfile}_log
${skelfile}
280
13
1
2
9
13
5
25
36
50
51
52
53
54
55
2
1 1
2 2
5
1
3
4
5
6
r
u 0.175 0.7  0.005
u 0.7   1.2  0.01
u 1.2   2.4  0.02
u 2.4   3.3  0.05
u 3.3   5.0  0.1
u 5.0  20.0  0.5
0*280
0*280
n
-1
EOF

fi
exit 0
