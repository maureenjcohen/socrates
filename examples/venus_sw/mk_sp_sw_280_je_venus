# ----------------------
if [ ! -s $SP_DIR/soluble_sw.avg ] ; then
  echo "$ABSORBER absorber ('soluble') aerosol (SW)"
  Cscatter_average -s $SKELFILE -P 1 -w -S $SOLSPEC \
    -a soluble_sw.avg soluble.mon
fi

# Sulphuric acid mode 1 (soot) aerosol
# ----------------------
if [ ! -s $SP_DIR/soot_sw.avg ] ; then
  echo 'Mode 1 ("soot") aerosol (SW)'
  Cscatter_average -s $SKELFILE -P 1 -w -S $SOLSPEC \
    -a soot_sw.avg soot.mon
fi

# Sulphuric acid mode 2 (sulph) aerosol
# ----------------------
if [ ! -s $SP_DIR/sulphuric_sw.avg ] ; then
  echo 'Mode 2 ("sulph") aerosol (SW)'
  Cscatter_average -s $SKELFILE -P 1 -w -S $SOLSPEC \
    -a sulphuric_sw.avg sulphuric.mon
fi

# Sulphuric acid mode 2' (oceanic) aerosol
# ----------------------
if [ ! -s $SP_DIR/oceanic_sw.avg ] ; then
  echo "Mode 2' ('oceanic') aerosol (SW)"
  Cscatter_average -s $SKELFILE -P 1 -w -S $SOLSPEC \
    -a oceanic_sw.avg oceanic.mon
fi

# Sulphuric acid mode 3 (ash) aerosol
# ----------------------
if [ ! -s $SP_DIR/sulphuric_sw.avg ] ; then
  echo 'Mode 3 ("ash") aerosol (SW)'
  Cscatter_average -s $SKELFILE -P 1 -w -S $SOLSPEC \
    -a ash_sw.avg ash.mon
fi



