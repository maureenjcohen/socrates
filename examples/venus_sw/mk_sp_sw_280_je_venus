    echo ": No visible LBL file: please run ./mk_hdo_lbl_sw_280_je_venus"
    exit 1
  else
    echo -n "visible "
    rm -f $SP_DIR/hdo_vis_l*
    Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} \
      -R 30 65 -l 50 ${COL_MASS_K_HDO} -b 5.0e-4 \
      -s ${SKELFILE} +S $SOLSPEC -lk \
      -o $SP_DIR/hdo_vis_l -m $SP_DIR/hdo_vis_lm \
      -L $SW_DATA/hdo_lbl_vis_${PT_FILE}.nc \
       > $SP_DIR/hdo_vis_log
  fi
else
  :
  #echo "Visible k file $SP_DIR/hdo_vis_l already exists"
fi

if [ ! -s $SP_DIR/hdo_swf_l ] ; then
  if [ ! -s $SW_DATA/hdo_lbl_swf_${PT_FILE}.nc ] ; then
    echo ": No near-IR LBL file: please run ./mk_hdo_lbl_sw_280_je_venus"
    exit 1
  else
    echo -n "near-IR "
    rm -f $SP_DIR/hdo_swf_l*
    Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} \
      -R 66 280 -l 50 ${COL_MASS_K_HDO} -b 5.0e-4 \
      -s ${SKELFILE} +S $SOLSPEC -lk \
      -o $SP_DIR/hdo_swf_l -m $SP_DIR/hdo_swf_lm \
      -L $SW_DATA/hdo_lbl_swf_${PT_FILE}.nc \
      -sm $SP_DIR/hdo_swf_l_map.nc \
       > $SP_DIR/hdo_swf_log
  fi
else
  :
  #echo "Near IR k file $SP_DIR/hdo_swf_l already exists"
fi
echo ' done'

echo -n "HCl"
if [ ! -s $SP_DIR/hcl_280_l ] ; then
