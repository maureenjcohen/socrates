    echo ${i},": No LBL file: please run ./mk_hcl_lbl_sw_280_je_venus"
    exit 1
  else
    rm -f $SP_DIR/hcl_280_l*
    Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} \
      -R 104 280 -l 51 ${COL_MASS_K_HCl} -b 5.0e-4 \
      -s $SKELFILE +S $SOLSPEC -lk \
      -o $SP_DIR/hcl_280_l -m $SP_DIR/hcl_280_lm \
      -L $SW_DATA/hcl_lbl_280_${PT_FILE}.nc \
       > $SP_DIR/hcl_280_log
  fi
else
  :
  #echo " lbl k file $SP_DIR/hcl_280_l already exists"
fi
echo " done"

echo -n "HF"
if [ ! -s $SP_DIR/hf_280_l ] ; then
  if [ ! -s $SW_DATA/hf_lbl_280_${PT_FILE}.nc ] ; then
    echo ${i},": No LBL file: please run ./mk_hf_lbl_sw_280_je_venus"
    exit 1
  else
    rm -f $SP_DIR/hf_280_l*
    Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} \
      -R 104 280 -l 52 ${COL_MASS_K_HF} -b 5.0e-4 \
      -s $SKELFILE +S $SOLSPEC -lk \
      -o $SP_DIR/hf_280_l -m $SP_DIR/hf_280_lm \
      -L $SW_DATA/hf_lbl_280_${PT_FILE}.nc \
       > $SP_DIR/hf_280_log
  fi
else
  :
  #echo " lbl k file $SP_DIR/hf_280_l already exists"
fi
echo " done"

echo -n 'cis-OSSO'
if [ ! -s $SP_DIR/cosso_u280_l ] ; then
  rm -f $SP_DIR/cosso_u280_l* $SP_DIR/cosso_lbl_uv.nc
  Ccorr_k -F $PT_UNSCALED -UVX cis-OSSO.uvxsc \
    -R 1 150 -i 0.2 -l 53 ${COL_MASS_K_cOSSO} -t 5.0e-4  \
    -s $SKELFILE +S $SOLSPEC \
    -o $SP_DIR/cosso_u280_l -m $SP_DIR/cosso_u280_lm -L $SP_DIR/cosso_lbl_uv.nc \
    -np $procs > $SP_DIR/cosso_u280_log
else
  :
  #echo " UV k file $SP_DIR/cosso_u280_l already exists"
fi
echo " done"

echo -n 'trans-OSSO'
if [ ! -s $SP_DIR/tosso_u280_l ] ; then
  rm -f $SP_DIR/tosso_u280_l* $SP_DIR/tosso_lbl_uv.nc
  Ccorr_k -F $PT_UNSCALED -UVX trans-OSSO.uvxsc \
    -R 1 150 -i 0.2 -l 54 ${COL_MASS_K_tOSSO} -t 5.0e-4  \
    -s $SKELFILE +S $SOLSPEC \
    -o $SP_DIR/tosso_u280_l -m $SP_DIR/tosso_u280_lm -L $SP_DIR/tosso_lbl_uv.nc \
    -np $procs > $SP_DIR/tosso_u280_log
else
  :
  #echo " UV k file $SP_DIR/tosso_u280_l already exists"
fi
echo " done"

echo -n 'OSO-S'
if [ ! -s $SP_DIR/yosos_u280_l ] ; then
  rm -f $SP_DIR/yosos_u280_l* $SP_DIR/yosos_lbl_uv.nc
  Ccorr_k -F $PT_UNSCALED -UVX OSO-S.uvxsc \
    -R 1 107 -i 0.2 -l 55 ${COL_MASS_K_yOSOS} -t 5.0e-4  \
    -s $SKELFILE +S $SOLSPEC \
    -o $SP_DIR/yosos_u280_l -m $SP_DIR/yososs_u280_lm -L $SP_DIR/yosos_lbl_uv.nc \
    -np $procs > $SP_DIR/yosos_u280_log
else
  :
  #echo " UV k file $SP_DIR/yosos_u280_l already exists"
fi
echo " done"

# Sulphuric acid aerosol
# ----------------------
